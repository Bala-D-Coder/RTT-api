# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:<port>/<db>
SPRING_DATASOURCE_USERNAME=<username>
SPRING_DATASOURCE_PASSWORD=<password>

# JWT Secrets (min 32 chars / 256 bits each)
JWT_ACCESS_SECRET=<generate-a-strong-random-string>
JWT_REFRESH_SECRET=<generate-a-different-strong-random-string>

# Admin Account (Seeded at startup)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=<strong-password>

# Demo Account (Pre-filled on login card)
DEMO_EMAIL=demo@yourdomain.com
DEMO_PASSWORD=<strong-password>
DEMO_CRED_TTL_HOURS=24

# Support contact rendered in 401 credentials_expired response
SUPPORT_EMAIL=support@yourdomain.com

# Speech Engine: gemini_live | mock
ENGINE=gemini_live
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=models/gemini-3.5-transcribe-live

# Push Notifications: firebase | noop
PUSH=firebase
FIREBASE_CREDENTIALS=/path/to/firebase-service-account.json

# Seeding (set false after first deploy)
SEED_ACCOUNTS=true
SEED_ON_STARTUP=true

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=https://yourdomain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# Google Sheets Webhook (optional)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/...
