# Database (Postgres container on port 5433)
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/rtt
SPRING_DATASOURCE_USERNAME=rtt_user
SPRING_DATASOURCE_PASSWORD=rtt_password

# JWT Secrets (Generate secure random 256-bit keys for production)
JWT_ACCESS_SECRET=your-32-byte-secret-for-access-token-signing-key!
JWT_REFRESH_SECRET=your-32-byte-secret-for-refresh-token-signing-key!

# Admin Account (Seeded at startup)
ADMIN_EMAIL=admin@apex.in
ADMIN_PASSWORD=bunny@123

# Demo Account (Pre-filled on login card)
DEMO_EMAIL=demo@apex.in
DEMO_PASSWORD=demo@123
DEMO_CRED_TTL_HOURS=24

# Support contact rendered in 401 credentials_expired response
SUPPORT_EMAIL=support@apex.in

# Speech Engine Selection: gemini_live | whisper_local | mock
ENGINE=gemini_live
GEMINI_API_KEY=your_gemini_api_key_here
WHISPER_URL=http://127.0.0.1:8001

# Push Notifications: firebase | noop
PUSH=noop
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# CORS Configuration (comma-separated lists)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# Google Sheets Webhook Integration
GOOGLE_SHEETS_WEBHOOK_URL=
